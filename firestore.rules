rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function grupoValido() {
      let d = request.resource.data;
      return (d.rol == 'Alumno'
              && d.keys().hasAll(['grupo'])
              && d.grupo in ['1A', '1B', '1C', '1D', '1E', '2A', '2B', '2C', '2D', '2E', '3A', '3B', '3C', '3D', '3E'])
          || (d.rol != 'Alumno' && !d.keys().hasAny(['grupo']));
    }

    match /comentarios/{id} {
      allow read: if resource.data.aprobado == true
                  || (request.auth != null && request.auth.uid == "Tnr5Z6CjmMfsYnVxLjWQbE9uU513");

      allow create: if request.resource.data.keys().hasOnly(['edicion', 'nombre', 'rol', 'texto', 'fecha', 'aprobado', 'grupo'])
                    && request.resource.data.keys().hasAll(['edicion', 'nombre', 'rol', 'texto', 'fecha', 'aprobado'])
                    && request.resource.data.edicion is string
                    && request.resource.data.nombre is string
                    && request.resource.data.texto is string
                    && request.resource.data.aprobado == false
                    && request.resource.data.fecha == request.time
                    && request.resource.data.nombre.size() >= 2
                    && request.resource.data.nombre.size() <= 40
                    && request.resource.data.texto.size() >= 3
                    && request.resource.data.texto.size() <= 500
                    && request.resource.data.rol in ['Alumno', 'Padre o madre de familia', 'Docente']
                    && grupoValido();

      allow update, delete: if request.auth != null
                            && request.auth.uid == "Tnr5Z6CjmMfsYnVxLjWQbE9uU513";
    }
    match /visitas/{id} {
      allow read: if request.auth != null && request.auth.uid == "Tnr5Z6CjmMfsYnVxLjWQbE9uU513";

      allow create: if request.resource.data.keys().hasOnly(['edicion', 'fecha', 'ciudad', 'region', 'pais', 'dispositivo'])
                    && request.resource.data.keys().hasAll(['edicion', 'fecha', 'ciudad', 'region', 'pais', 'dispositivo'])
                    && request.resource.data.edicion is string
                    && request.resource.data.edicion.size() <= 60
                    && request.resource.data.ciudad is string
                    && request.resource.data.ciudad.size() <= 60
                    && request.resource.data.region is string
                    && request.resource.data.region.size() <= 60
                    && request.resource.data.pais is string
                    && request.resource.data.pais.size() <= 60
                    && request.resource.data.fecha == request.time
                    && request.resource.data.dispositivo in ['movil', 'tablet', 'escritorio'];
    }

    match /articulos/{edicion} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "Tnr5Z6CjmMfsYnVxLjWQbE9uU513";
    }

    function suma1(campo) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([campo])
          && request.resource.data[campo] == resource.data[campo] + 1;
    }

    match /reacciones/{id} {
      allow read: if true;
      allow create, delete: if request.auth != null && request.auth.uid == "Tnr5Z6CjmMfsYnVxLjWQbE9uU513";
      allow update: if (request.auth != null && request.auth.uid == "Tnr5Z6CjmMfsYnVxLjWQbE9uU513")
                    || suma1('aplauso') || suma1('wow') || suma1('corazon') || suma1('idea');
    }

    match /trivias/{edicion} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "Tnr5Z6CjmMfsYnVxLjWQbE9uU513";
    }

    function grupoTrivia() {
      return request.resource.data.grupo in ['1A', '1B', '1C', '1D', '1E', '2A', '2B', '2C', '2D', '2E', '3A', '3B', '3C', '3D', '3E'];
    }

    match /trivia_resultados/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['edicion', 'grupo', 'aciertos', 'total', 'fecha'])
                    && request.resource.data.keys().hasAll(['edicion', 'grupo', 'aciertos', 'total', 'fecha'])
                    && request.resource.data.edicion is string
                    && request.resource.data.edicion.size() <= 60
                    && grupoTrivia()
                    && request.resource.data.aciertos is int
                    && request.resource.data.total is int
                    && request.resource.data.total >= 3 && request.resource.data.total <= 10
                    && request.resource.data.aciertos >= 0
                    && request.resource.data.aciertos <= request.resource.data.total
                    && request.resource.data.fecha == request.time;
      allow delete: if request.auth != null && request.auth.uid == "Tnr5Z6CjmMfsYnVxLjWQbE9uU513";
    }

    match /trivia_nombres/{id} {
      allow read, delete: if request.auth != null && request.auth.uid == "Tnr5Z6CjmMfsYnVxLjWQbE9uU513";
      allow create: if request.resource.data.keys().hasOnly(['edicion', 'nombre', 'grupo', 'aciertos', 'fecha', 'respuestas'])
                    && request.resource.data.keys().hasAll(['edicion', 'nombre', 'grupo', 'aciertos', 'fecha'])
                    && request.resource.data.edicion is string
                    && request.resource.data.edicion.size() <= 60
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() >= 2
                    && request.resource.data.nombre.size() <= 40
                    && grupoTrivia()
                    && request.resource.data.aciertos is int
                    && request.resource.data.aciertos >= 0
                    && request.resource.data.aciertos <= 10
                    && request.resource.data.fecha == request.time
                    && (!request.resource.data.keys().hasAny(['respuestas'])
                        || (request.resource.data.respuestas is list
                            && request.resource.data.respuestas.size() <= 10
                            && request.resource.data.respuestas.hasOnly([0, 1, 2, 3])));
    }

    match /config/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == "Tnr5Z6CjmMfsYnVxLjWQbE9uU513";
    }
  }
}
